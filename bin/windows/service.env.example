# ==============================================================================
# Denodo AI SDK - Windows Service Configuration
# ==============================================================================

# Service startup type: manual (default), auto, delayed, or disabled
DENODO_AI_SDK_SERVICE_STARTUP=manual

# Execution mode: both (default), api, or sample_chatbot
DENODO_AI_SDK_SERVICE_MODE=both

# Log level: INFO (default), DEBUG
DENODO_AI_SDK_SERVICE_LOG_LEVEL=INFO

# Enable remote MCP server (0 = disabled, 1 = enabled)
DENODO_AI_SDK_SERVICE_MCP=0

# Timeout in seconds for service initialization (default: 30)
DENODO_AI_SDK_SERVICE_TIMEOUT=30

# Application log management
DENODO_AI_SDK_SERVICE_MAX_LOG_SIZE=1
DENODO_AI_SDK_SERVICE_MAX_LOG_FILES=5

# Data directory for logs and other generated files (default: data/)
# This must match the AI_SDK_DATA_DIR setting in the API and Chatbot config files.
# AI_SDK_DATA_DIR=data/

# Virtual environment folder name or path (optional)
# If empty or not defined, it auto-detects 'venv' and '.venv' in the project root.
# Examples: venv, .venv, custom_env, D:\venvs\denodo_ai
# DENODO_AI_SDK_SERVICE_VENV_DIR=venv

# Pause console on error (0 = disabled / for automation, 1 = enabled / for manual debugging)
DENODO_AI_SDK_SERVICE_PAUSE_ON_ERROR=0
