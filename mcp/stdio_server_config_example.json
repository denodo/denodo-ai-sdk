{
    "denodo_aisdk_local": {
        "command": "uv",
        "args": [
        "run",
        "--with",
        "fastmcp",
        "fastmcp",
      "run",
      "{ABSOLUTE_PATH}/mcp/server.py"
    ],
    "env": {
        "MCP_AI_SDK_ENDPOINT": "http://localhost:8008",
        "MCP_AI_SDK_USER": "admin",
        "MCP_AI_SDK_PASSWORD": "admin",
        "MCP_AI_SDK_VERIFY_SSL": "false"
        }
    }
}