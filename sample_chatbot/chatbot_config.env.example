## ==============================
## .ENV.EXAMPLE STRUCTURE
## Line starts with:
## ## (double hash) = Text explanation, description or section header. Only one space between the ## and the text.
## #  (single hash) = Commented-out configuration parameter. No space between the # and the parameter name.
## No hash          = Active configuration parameter with a default value
##
## Configuration parameters use KEY=VALUE with no spaces around =
## ==============================

## ==============================
## Denodo AI SDK
## Sample chatbot configuration parameters
##
## This file contains the necessary parameters to configure the sample chatbot.
## Please review all sections carefully to ensure proper functionality.
##
## Sections:
## 1- CHATBOT CONFIGURATION
## 2- LLM CONFIGURATION
## 3- VECTOR STORE CONFIGURATION
## 4- AI SDK CONFIGURATION
## 5- LANGFUSE
## 6- DATABASE CONFIGURATION
## ==============================

## ==============================
## 1. CHATBOT CONFIGURATION
## Set the host, port, and other general chatbot settings.
## ==============================

CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=9992

## AI_SDK_DATA_DIR defines a centralized base directory for all persistent data
## generated by the AI SDK API and the sample chatbot (including logs, embeddings cache, CSV uploads, etc).
## IMPORTANT: If you are running both the AI SDK API and the sample chatbot at the same time,
## this variable MUST point to the exact same directory in both configuration files.
## If not set, it defaults to the current directory (.).
## Both relative and absolute paths can be set here.
#AI_SDK_DATA_DIR=/app/data

## CHATBOT_ROOT_PATH allows the sample chatbot to run on a different path. For example,
## CHATBOT_ROOT_PATH=denodo-ai-sdk serves the chatbot UI and chatbot backend API under /denodo-ai-sdk/ (with or
## without a leading slash in this file; trailing slashes are normalized away).
## Open the app at a URL that ends with a slash, e.g. https://localhost:9992/denodo-ai-sdk/
#CHATBOT_ROOT_PATH=denodo-ai-sdk

## If you want to activate HTTPS, write down the key and certificate path here.
#CHATBOT_SSL_CERT=cert.pem
#CHATBOT_SSL_KEY=key.pem

## When deploying to production, you might want to use multiple workers (cores) by setting CHATBOT_WORKERS.
CHATBOT_WORKERS=1

## CHATBOT_TIMEOUT is used in two instances. First, it sets the timeout of the worker in seconds
## in production mode. This is important when making a request to deepQuery which is expected to
## take longer amounts of time while the analysis is being carried out. Second, it sets the timeout
## for any call to the AI SDK at the request level (even when not in production mode).
## Default is 1200 seconds (20 minutes).
#CHATBOT_TIMEOUT=1200

## You can set CHATBOT_DEEPQUERY to 0 to disable the DeepQuery feature.
CHATBOT_DEEPQUERY=1

## If CHATBOT_REPORTING is set to 1, all the users queries, responses and token usage will be recorded in reports/user_report.csv.
## Please set it to 0 to avoid this behaviour.
CHATBOT_REPORTING=1

## Max size in megabytes of the reports generated in reports/. Will create a new timestamped one after reaching maxsize.
## Defaults to 10 mb.
CHATBOT_REPORT_MAX_SIZE=10

## Maximum number of report CSV files to keep in the reports/ directory.
## Set to 0 to disable the limit. Defaults to 10.
CHATBOT_REPORT_MAX_FILES=10

## By default, users can add feedback (positive or negative) + details on specific interactions.
## This feedback is added to the report in reports/user_report.csv.
CHATBOT_FEEDBACK=1

## By default, users can upload their own unstructured data through CSV files and ask questions about their documents.
## Set CHATBOT_UNSTRUCTURED_MODE=0 to disable it.
CHATBOT_UNSTRUCTURED_MODE=1

## CHATBOT_ALLOWED_UNSTRUCTURED_ROLES and CHATBOT_ALLOWED_UNSTRUCTURED_USERS restrict who can use the unstructured mode.
## Define them as a comma-separated list of roles or usernames. 
## If CHATBOT_UNSTRUCTURED_MODE=1 and both of these are empty, all users will have access.
## Note: Role restrictions are not supported if connecting to a legacy Data Marketplace (<= 9.4.1);
## use CHATBOT_ALLOWED_UNSTRUCTURED_USERS instead.
#CHATBOT_ALLOWED_UNSTRUCTURED_ROLES=unstructured_role,unstructured_role2
#CHATBOT_ALLOWED_UNSTRUCTURED_USERS=unstructured_user,unstructured_user2

## Skills are reusable, on-demand guidance for the chatbot.
## System skills live in the skills/ folder inside AI_SDK_DATA_DIR (like reports and conversation
## history) and are visible to every user. Personal skills are created/uploaded by each user through
## the Skills Manager or the chat, are stored in the conversations history database, and are only
## visible to their owner. Users can activate/deactivate any skill for themselves.
## Reading skills and managing personal skills is available to everyone; managing SYSTEM skills is
## restricted: by default, only global administrators can edit them.
## CHATBOT_ALLOWED_SKILL_ROLES and CHATBOT_ALLOWED_SKILL_USERS additionally grant system skill
## management to specific roles or usernames. Define them as a comma-separated list.
## Note: Role restrictions are not supported if connecting to a legacy Data Marketplace (<= 9.4.1);
## use CHATBOT_ALLOWED_SKILL_USERS instead.
#CHATBOT_ALLOWED_SKILL_ROLES=skill_editor_role
#CHATBOT_ALLOWED_SKILL_USERS=skill_editor_user

## Allow users to edit LLM settings (provider, model, temperature, max_tokens) through the settings modal.
## Set to 1 to enable LLM editing, 0 to disable. This setting cannot be changed after startup.
CHATBOT_USER_EDIT_LLM=0

## The chatbot LLM might decide to request a graph generation even when not explicitly asked for in your question.
## To instruct the chatbot LLM to only generate a graph when explicitly requested, set CHATBOT_AUTO_GRAPH=0.
CHATBOT_AUTO_GRAPH=1

## CHATBOT_INPUT_METHOD controls the default key combination used to send a question from the question form.
## Each user can override this default from the User Profile modal.
##   - enter (default): Enter sends the question, Shift+Enter inserts a newline.
##   - ctrl_enter: Ctrl+Enter sends the question, Shift+Enter inserts a newline and plain Enter is ignored.
##     Recommended for IME-based languages (Japanese, Chinese, Korean...) where Enter confirms the character conversion.
##     On macOS, Cmd+Enter also sends the question.
CHATBOT_INPUT_METHOD=enter

## CHATBOT_ALLOW_SYNC controls whether the Vector DB Management modal is available.
## Set to 1 to enable synchronization features; 0 to disable them completely.
## When enabled and AI_SDK_USERNAME is set, the configured credentials are used.
## When enabled and AI_SDK_USERNAME is NOT set, the logged-in user's own credentials
## are passed to the AI SDK and the user must have sync permissions (AI_SDK_ALLOWED_METADATA_USERS).
CHATBOT_ALLOW_SYNC=1

## Whether to verify SSL certificates for AI SDK requests.
## Set to 1 to enable SSL verification; 0 to disable (default: 0).
AI_SDK_VERIFY_SSL=0

## If working in an offline, restricted environment and you need to connect to external endpoints with custom certificates,
## please use the following variables to point to those certificates for SSL verification.
## NOTE: The following path has been provided as reference, please set your own.
#REQUESTS_CA_BUNDLE=/home/denodo9_dev/denodo-ai-sdk-public-9-dev/denodo-ai-sdk-public-9-dev/SampleCA.cer
#SSL_CERT_FILE=/home/denodo9_dev/denodo-ai-sdk-public-9-dev/denodo-ai-sdk-public-9-dev/SampleCA.cer

## Default instruction text for the general agent, shown in the settings General tab.
## Per-custom-agent defaults are set under settings.custom_instructions in each agent YAML file.
#CHATBOT_CUSTOM_INSTRUCTIONS=

## Controls whether the user can edit custom instructions from the UI.
CHATBOT_USER_EDIT_INSTRUCTIONS=1

## ==============================
## 2. LLM/Embeddings CONFIGURATION
## Specify the LLM provider, model, and API key for both LLM and embeddings model for the chatbot.
## You can specify either a base model or a reasoning model for the chatbot here, but please
## note that the reasoning model will take longer to respond since it needs to generate thinking tokens
## before every response.
## ==============================

CHATBOT_LLM_PROVIDER=OpenAI
CHATBOT_LLM_MODEL=gpt-5.2-none

## CHATBOT_LLM_TEMPERATURE defines the temperature setting for the chatbot LLM (0.0 to 2.0 for OpenAI, 0.0 to 1.0 for others).
CHATBOT_LLM_TEMPERATURE=0.5

## CHATBOT_LLM_MAX_TOKENS defines the maximum OUTPUT tokens for the chatbot LLM. Not recommended to decrease this value.
CHATBOT_LLM_MAX_TOKENS=4096

CHATBOT_EMBEDDINGS_PROVIDER=OpenAI
CHATBOT_EMBEDDINGS_MODEL=text-embedding-3-large

## HOW TO CONFIGURE REASONING EFFORT
## Depending on your provider, you can control the level of reasoning of the chatbot LLM by appending a reasoning effort suffix to the model ID.
## Under the hood, the AI SDK parses that suffix from the model ID and forwards it as the provider's
## reasoning/thinking parameter (for example reasoning_effort for OpenAI/Azure, thinking_level for Gemini,
## or the equivalent field for other providers below). The suffix is stripped before the model/deployment
## name is sent to the provider.
## This convenience feature is native to the AI SDK (not the provider) and may not work correctly for all models.
## Please refer to the provider's documentation for the supported reasoning efforts for each specific model.
## NOTE: To use the default behavior of the model as intended by the provider,
## do not append any reasoning effort suffix to the model ID.
## 1. AWS BEDROCK
## Some Claude reasoning models can work in both thinking and non-thinking mode.
## To toggle thinking, append "-enablethinking" to the model ID.
## You can then control the "level" of thinking, by allocating a set amount of tokens in AWS_CLAUDE_THINKING_TOKENS.
## Example: anthropic.claude-sonnet-4-5-20250929-v1:0-enablethinking
## 2a. GOOGLE (Gemini models on Google Vertex)
## You can control reasoning, by appending one of the following reasoning effort suffixes to the model ID:
## low, medium, high
## Example: gemini-3.5-flash-low
## 2b. GOOGLE (Anthropic models on Google Vertex, with GOOGLE_ANTHROPIC_DEPLOYMENT=1)
## You can control reasoning, by appending one of the following reasoning effort suffixes to the model ID:
## low, medium, high, xhigh, max
## Example: claude-opus-4-8-low
## 3. OPENROUTER
## Add -thinking or -no-thinking to the end of the model ID.
## This will attempt to activate/deactivate thinking when calling the LLM through OpenRouter.
## Example: openai/gpt-5.4-thinking
## 4. OPENAI
## You can control reasoning, by appending one of the following reasoning effort suffixes to the model ID:
## none, minimal, low, medium, high, xhigh.
## Example: gpt-5.2-low
## 5. AZURE
## Same suffixes as OpenAI: none, minimal, low, medium, high, xhigh.
## The suffix is stripped from the deployment name before the call
## (e.g. gpt-5-mini-high → deployment gpt-5-mini with reasoning_effort=high).
## Example: gpt-5-mini-low

## ==============================
## Ollama
## There is no specific configuration for Ollama, but:
##      - You must have the model already installed first through Ollama
##      - You must use the same model ID in CHAT_MODEL and SQL_GENERATION_MODEL as the one you use in Ollama
## There's no need to execute 'ollama run <model-id>' to use it in the AI SDK.
## The SDK will automatically attempt to connect to the default Ollama base URL and port, but
## you can modify this using the parameter OLLAMA_API_BASE_URL.
## ==============================

#OLLAMA_API_BASE_URL=http://localhost:11434

## ==============================
## OpenAI
## If you want to have two different OpenAI-API compatible providers, please check the user manual.
## ==============================

## OPENAI_API_KEY defines the API key for your OpenAI account.
#OPENAI_API_KEY=

## OpenAI base url can be set OPTIONALLY if using a OpenAI-compatible provider different from OpenAI.
#OPENAI_BASE_URL=

## OpenAI proxy to use. Set as http://{user}:{pwd}@{host}:{port} format.
#OPENAI_PROXY_URL=

## Set to 1 to verify the SSL certificate of the proxy. Defaults to 0 (off).
#OPENAI_PROXY_VERIFY_SSL=0

## OpenAI organization ID. If not set it will use the default.
#OPENAI_ORG_ID=

## OPENAI_RESPONSES_API enables OpenAI's Responses API instead of Chat Completions.
## 1 = enabled (default), 0 = disabled
OPENAI_RESPONSES_API=1

## You can set the dimensions (size of the vector object) with this variable for the embeddings model.
## It is recommended to leave it to the model's default dimension size.
#OPENAI_EMBEDDINGS_DIMENSIONS=

## ==============================
## Azure
## Please set the deployment name in the CHAT_MODEL/SQL_GENERATION_MODEL variables.
## The model (deployment) name used will be appended to the Azure endpoint, like this:
## /deployments/{CHAT_MODEL}
## ==============================

## AZURE_ENDPOINT and AZURE_API_VERSION define the connection string and version to your Azure instance.
## AZURE_ENDPOINT refers to the everything until the azure.com domain.
## For example: https://example-resource.openai.azure.com/
## The AI SDK will automatically append /openai/deployments/{model_name}/chat/completions... to the endpoint.
#AZURE_ENDPOINT=
#AZURE_API_VERSION=

## AZURE_API_KEY defines the API key for your Azure account.
#AZURE_API_KEY=

## Azure proxy to use. Set as http://{user}:{pwd}@{host}:{port} format.
#AZURE_PROXY=

## Set to 1 to verify the SSL certificate of the proxy. Defaults to 0 (off).
#AZURE_PROXY_VERIFY_SSL=0

## AZURE_RESPONSES_API enables OpenAI's Responses API instead of Chat Completions.
## 1 = enabled, 0 = disabled (default)
#AZURE_RESPONSES_API=0

## You can set the dimensions (size of the vector object) with this variable for the embeddings model.
## It is recommended to leave it to the model's default dimension size.
#AZURE_EMBEDDINGS_DIMENSIONS=

## ==============================
## Google (Vertex AI)
## NOTE: This is Google Cloud's Vertex AI service, meant for production.
## ==============================

## GOOGLE_APPLICATION_CREDENTIALS defines the path to the JSON storing your Google Application Credentials.
#GOOGLE_APPLICATION_CREDENTIALS=

## GOOGLE_REGION defines the Google Cloud region for Vertex AI requests.
## When unset, requests use the Vertex AI client's default region.
#GOOGLE_REGION=

## Enable GOOGLE_ANTHROPIC_DEPLOYMENT when using an Anthropic Claude model in Google Vertex AI.
## 1 = enabled, 0 = disabled (default).
#GOOGLE_ANTHROPIC_DEPLOYMENT=0

## ==============================
## Google AI Studio
## NOTE: Not intended for production.
## ==============================

## GOOGLE_AI_STUDIO_API_KEY is your Google AI Studio API key.
#GOOGLE_AI_STUDIO_API_KEY=

## ==============================
## Groq
## ==============================

## GROQ_API_KEY defines the API key for your Groq account.
#GROQ_API_KEY=

## ==============================
## OpenRouter
## ==============================

## OPENROUTER_API_KEY defines the API key for your OpenRouter account.
#OPENROUTER_API_KEY=

## In a comma-separated list, you can specify the providers you prefer OpenRouter route your LLM calls to.
#OPENROUTER_PREFERRED_PROVIDERS=

## ==============================
## SambaNova
## ==============================

## SAMBANOVA_API_KEY defines the API key for your SambaNova account.
#SAMBANOVA_API_KEY=

## ==============================
## Bedrock
## ==============================

## If your LLM_MODEL is an AWS ARN, specifying the model provider (e.g., 'anthropic') is MANDATORY.
## It can be specified directly in the LLM_MODEL variable using the 'provider:arn:...' format.

## AWS_REGION, AWS_PROFILE_NAME, AWS_ROLE_ARN, AWS_SECRET_ACCESS_KEY, and AWS_ACCESS_KEY_ID
## define the connection parameters to your AWS Bedrock instance.
## If using EC2 with an IAM profile, you only need to set AWS_REGION to select the region you want to deploy Bedrock in.
## This is relevant because different regions have different models/costs/latencies and it is a required parameter by AWS when making a call.
#AWS_REGION=
#AWS_PROFILE_NAME=
#AWS_ROLE_ARN=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

## AWS_CUSTOM_URL can be used to change the base endpoint_url for custom setups outside of the regional ones offered by Bedrock.
## Example: https://myai.mycompany.com
#AWS_CUSTOM_URL=

## By default, AWS SDK use the global STS endpoint (https://sts.amazonaws.com).
## To enable region-specific STS endpoints (e.g., https://sts.us-west-2.amazonaws.com),
## uncomment the following line:
#AWS_STS_REGIONAL_ENDPOINTS=regional

## Set the number of tokens allocated for Claude's thinking process.
## This controls how much the model can "think" before generating the final response.
## Higher values allow for more thorough reasoning but consume more tokens.
#AWS_CLAUDE_THINKING_TOKENS=2000

## ==============================
## Mistral
## ==============================

#MISTRAL_API_KEY=

## ==============================
## NVIDIA NIM
## ==============================

#NVIDIA_API_KEY=

## If self-hosting NVIDIA NIM, set the base url here, like "http://localhost:8000/v1"
#NVIDIA_BASE_URL=

## ==============================
## Custom Providers
## You can configure any non-standard provider or multiple instances of the same provider type (e.g., two different Azure endpoints).
## ==============================

## ------------------------------
## Example 1: Custom OpenAI-Compatible Provider
## ------------------------------
## Use this for any LLM that exposes an OpenAI-compatible API.
## 1. Choose a provider name, for example: MY_API
## 2. Set it in section 4, e.g., LLM_PROVIDER=MY_API
## 3. Define its parameters, following the pattern: [PROVIDER_NAME]_API_KEY, [PROVIDER_NAME]_BASE_URL, etc.
## The format for the base URL should be in this format: https://domain.com/v1 (http if using localhost)

## Example custom OpenAI-compatible provider configuration
## MY_API_API_KEY=
## MY_API_BASE_URL=
## MY_API_PROXY=
## MY_API_PROXY_VERIFY_SSL=0
## MY_API_RESPONSES_API=0

## ------------------------------
## Example 2: Custom Azure Providers
## ------------------------------
## Use this when you need separate configurations for LLM and embeddings, especially if they use different API versions.
## 1. Choose provider names that MUST start with "AZURE_", for example: AZURE_LLM and AZURE_EMBEDDING
## 2. Set them in section 4:
##    LLM_PROVIDER=AZURE_LLM
##    EMBEDDINGS_PROVIDER=AZURE_EMBEDDING
## 3. Define their parameters, following the pattern: [PROVIDER_NAME]_ENDPOINT, [PROVIDER_NAME]_API_VERSION, etc.

## Example custom Azure provider LLM configuration
## AZURE_LLM_ENDPOINT=
## AZURE_LLM_API_KEY=
## AZURE_LLM_API_VERSION=
## AZURE_LLM_PROXY=
## AZURE_LLM_PROXY_VERIFY_SSL=0
## AZURE_LLM_RESPONSES_API=0

## Example custom Azure provider embeddings configuration (with a different API version) ---
## AZURE_EMBEDDING_ENDPOINT=
## AZURE_EMBEDDING_API_KEY=
## AZURE_EMBEDDING_API_VERSION=
## AZURE_EMBEDDING_EMBEDDINGS_DIMENSIONS=

## ==============================
## Custom Headers
## You can define custom HTTP headers to be sent with API requests.
## This is useful for passing authentication tokens, subscription keys, or other metadata.
## ==============================

## IMPORTANT: This functionality is specifically designed for providers
## compatible with the OpenAI/Azure API structure. It applies to:
## - "OpenAI" (standard)
## - "Azure" (standard)
## - Custom OpenAI-compatible providers (e.g., "MYAPI")
## - Custom Azure-compatible providers (e.g., "AZURE_DEV")

## The syntax is: PROVIDER_NAME_HEADER_Header-Name=HeaderValue
## - Replace PROVIDER_NAME with the provider's name in uppercase (e.g., MYAPI, AZURE).
## - Replace Header-Name with the actual HTTP header name (e.g., Ocp-Apim-Subscription-Key).
## - Replace HeaderValue with the value for that header.

## Example for a Custom OpenAI-compatible provider named "MYAPI"
## MYAPI_HEADER_X-Subscription-Key=HeaderValue

## ==============================
## 3. VECTOR STORE CONFIGURATION
## Specify the vector store provider.
## Available: Chroma, PGVector, OpenSearch, Oracle
## ==============================

CHATBOT_VECTOR_STORE_PROVIDER=Chroma

## ==============================
## PGVector
## ==============================

## The full connection string to the PGVector with username and password.
## For example: postgresql+psycopg://langchain:langchain@localhost:6024/langchain
## Must include postgresql+psycopg at the beginning. After that it's user:pwd@host:port/db
#PGVECTOR_CONNECTION_STRING=

## ==============================
## OpenSearch
## ==============================

## The URL of the OpenSearch instance. Default: http://localhost:9200
#OPENSEARCH_URL=
#OPENSEARCH_USERNAME=
#OPENSEARCH_PASSWORD=

## ==============================
## Oracle Vector DB
## ==============================

## The Data Source Name of the Oracle instance.
#ORACLE_DSN=
#ORACLE_USERNAME=
#ORACLE_PASSWORD=

## ==============================
## 4. AI SDK CONFIGURATION
## Set the connection details for the AI SDK.
## The USERNAME and PASSWORD are needed if you want chatbot users to be able to sync the vector store from the chatbot.
## These credentials must be the credentials of the user with permissions to execute the getMetadata endpoint.
## ==============================

AI_SDK_URL=http://localhost:8008
AI_SDK_USERNAME=admin
AI_SDK_PASSWORD=admin

## Only the AI SDK server has access to the Data Marketplace URL.
## If you want to expose it in the chatbot for automatic view linking, include the DC URL here.
#CHATBOT_DATA_MARKETPLACE_URL=

## ==============================
## 5. LANGFUSE (telemetry/tracing)
## Configure Langfuse to collect traces from the AI SDK and observe in real-time the pipeline at work.
## ==============================

## LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY identify your Langfuse project.
## Both are required to enable tracing.
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=

## Set the Langfuse host here. Can either use cloud or local (open-source).
#LANGFUSE_HOST=https://us.cloud.langfuse.com

## Optional: Prefix for Langfuse user IDs.
## Sample chatbot traces use {LANGFUSE_USER}_{REQUEST_USER} when this is set
## (e.g. IT_admin when LANGFUSE_USER=IT and the logged-in user is admin).
## When unset, only the request user is used. API traces that do not pass a
## request user still use LANGFUSE_USER alone as the user id.
#LANGFUSE_USER=

## ==============================
## 6. DATABASE CONFIGURATION
## Specify the relational database provider.
## This database is used to store user chat history and conversations.
## Available: SQLite, PostgreSQL, Oracle
## ==============================

CHATBOT_DATABASE_PROVIDER=SQLite

## Maximum number of chats a user can have stored before oldest ones are deleted.
#CHATBOT_MAX_CHATS_PER_USER=50

## Maximum number of messages kept per chat before truncating the history.
#CHATBOT_MAX_MESSAGES_PER_CHAT=100

## Maximum file size in megabytes allowed when importing chat history (JSON).
#CHATBOT_MAX_IMPORT_FILE_SIZE_MB=5

## ==============================
## PostgreSQL
## ==============================

## The full connection string to the PostgreSQL database with username and password.
## For example: postgresql://user:pass@localhost:5432/db_name
#POSTGRESQL_DATABASE_CONNECTION_STRING=

## ==============================
## Oracle
## ==============================

## Setup: To use the Oracle checkpointer, you will need an Oracle AI Database instance.
## A local container (for example container-registry.oracle.com/database/free:latest) or 
## an Oracle Autonomous Database in OCI both work.
## Define the connection parameters specifically for this relational database.
#ORACLE_DATABASE_DSN=
#ORACLE_DATABASE_USERNAME=
#ORACLE_DATABASE_PASSWORD=