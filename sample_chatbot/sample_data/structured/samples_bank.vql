ALTER DATABASE samples_bank
  CHARSET DEFAULT;

CREATE OR REPLACE WRAPPER DF ds_bank_loan
    FOLDER = '/02 - Datasets'
    DATASOURCENAME=ds_bank_loan
    OUTPUTSCHEMA (
        loan_id = 'loan_id',
        customer_id = 'customer_id',
        loan_amount = 'loan_amount',
        interest_rate = 'interest_rate',
        term_years = 'term',
        property_id = 'property_id',
        loan_officer_id = 'loan_officer_id',
        status = 'status',
        loan_origination_date = 'date_created'
    );

CREATE OR REPLACE WRAPPER DF ds_bank_account
    FOLDER = '/02 - Datasets'
    DATASOURCENAME=ds_bank_account
    OUTPUTSCHEMA (
        acct_id = 'acct_id',
        customer_id = 'customer_id',
        acct_type = 'acct_type',
        balance = 'balance',
        account_opened_date = 'date_created'
    );

CREATE OR REPLACE WRAPPER DF ds_bank_customer
    FOLDER = '/02 - Datasets'
    DATASOURCENAME=ds_bank_customer
    OUTPUTSCHEMA (
        customer_id = 'customer_id',
        first_name = 'first_name',
        last_name = 'last_name',
        email = 'email',
        phone_number = 'phone_number',
        address = 'address',
        city = 'city',
        state = 'state',
        zip_code = 'zip_code'
    );

