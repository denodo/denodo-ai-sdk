    );

CREATE OR REPLACE WRAPPER DF ds_bank_rate
    FOLDER = '/02 - Datasets'
    DATASOURCENAME=ds_bank_rate
    OUTPUTSCHEMA (
        rate_id = 'rate_id',
        loan_type = 'loan_type',
        term_years = 'term',
        interest_rate = 'interest_rate'
    );

CREATE OR REPLACE WRAPPER DF ds_bank_underwriting
    FOLDER = '/02 - Datasets'
    DATASOURCENAME=ds_bank_underwriting
    OUTPUTSCHEMA (
        underwriting_id = 'underwriting_id',
        loan_id = 'loan_id',
        credit_score = 'credit_score',
        employment_history = 'employment_history',
        financial_history = 'financial_history'
    );

CREATE OR REPLACE TABLE account I18N us_pst (
        acct_id:int,
        customer_id:int,
        acct_type:text (description = 'Product type. Valid values (case-sensitive): Checking, Savings, Money Market, CD. Checking: everyday deposits and debits. Savings: interest-bearing deposit. Money Market: higher-balance savings tier with tiered rates. CD: certificate of deposit, fixed term until maturity.'),
        balance:double (description = 'Current balance in USD'),
        account_opened_date:localdate
    )
    FOLDER = '/02 - Datasets'
    DESCRIPTION = 'One row per bank account. Monetary amounts are USD. Join to customer for holder profile.'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_bank_account(
        I18N us_pst
        CONSTRAINTS (
             ADD acct_id NOS ZERO ()
             ADD customer_id NOS ZERO ()
             ADD acct_type NOS ZERO ()
             ADD balance NOS ZERO ()
             ADD account_opened_date NOS ZERO ()
        )
        OUTPUTLIST (acct_id, acct_type, balance, customer_id, account_opened_date
        )
        WRAPPER (df ds_bank_account)
    );

CREATE OR REPLACE TABLE customer I18N us_pst (
        customer_id:int,
        first_name:text,
        last_name:text,
        email:text,
        phone_number:text,
        address:text,
        city:text,
        state:text,
        zip_code:text
    )
    FOLDER = '/02 - Datasets'
    DESCRIPTION = 'One row per customer. Use as the primary customer dimension. Join to samples_bank.loan and samples_bank.account on customer_id.'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_bank_customer(
        I18N us_pst
        CONSTRAINTS (
             ADD customer_id NOS ZERO ()
             ADD first_name NOS ZERO ()
             ADD last_name NOS ZERO ()
             ADD email NOS ZERO ()
             ADD phone_number NOS ZERO ()
             ADD address NOS ZERO ()
             ADD city NOS ZERO ()
             ADD state NOS ZERO ()
             ADD zip_code NOS ZERO ()
        )
        OUTPUTLIST (address, city, customer_id, email, first_name, last_name, phone_number, state, zip_code
        )
        WRAPPER (df ds_bank_customer)
    );

CREATE OR REPLACE TABLE loan I18N us_pst (
        loan_id:int,
        customer_id:int,
        loan_amount:double (description = 'Principal in USD'),
        interest_rate:double (description = 'Annual rate as a percentage (e.g. 4.5 means 4.5%)'),
        term_years:int,
        property_id:int,
        loan_officer_id:int,
        status:text (description = 'Application status. Valid values (case-sensitive): approved, pending, rejected'),
        loan_origination_date:localdate
    )
    FOLDER = '/02 - Datasets'
    DESCRIPTION = 'Mortgage-style loans. One row per loan application. Use for origination, status, term, and principal. For individual payments and repayment timing, use samples_bank.payment. Monetary amounts are USD.'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_bank_loan(
        I18N us_pst
        CONSTRAINTS (
             ADD loan_id NOS ZERO ()
             ADD customer_id NOS ZERO ()
             ADD loan_amount NOS ZERO ()
             ADD interest_rate NOS ZERO ()
             ADD term_years NOS ZERO ()
             ADD property_id NOS ZERO ()
             ADD loan_officer_id NOS ZERO ()
             ADD status NOS ZERO ()
             ADD loan_origination_date NOS ZERO ()
        )
        OUTPUTLIST (customer_id, loan_origination_date, interest_rate, loan_amount, loan_id, loan_officer_id, property_id, status, term_years
        )
        WRAPPER (df ds_bank_loan)
    );

CREATE OR REPLACE TABLE loan_officer I18N us_pst (
        loan_officer_id:int,
        first_name:text,
        last_name:text,
        email:text,
        phone_number:text
    )
    FOLDER = '/02 - Datasets'
    DESCRIPTION = 'One row per loan officer. Join to samples_bank.loan on loan_officer_id to analyze assignments and workload.'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_bank_loan_officer(
        I18N us_pst
        CONSTRAINTS (
             ADD loan_officer_id NOS ZERO ()
             ADD first_name NOS ZERO ()
             ADD last_name NOS ZERO ()
             ADD email NOS ZERO ()
             ADD phone_number NOS ZERO ()
        )
        OUTPUTLIST (email, first_name, last_name, loan_officer_id, phone_number
        )
        WRAPPER (df ds_bank_loan_officer)
    );

CREATE OR REPLACE TABLE payment I18N us_pst (
        payment_id:int,
        loan_id:int,
        payment_amount:double (description = 'Amount in USD'),
        payment_date:localdate
    )
    FOLDER = '/02 - Datasets'
    DESCRIPTION = 'One row per payment applied to a loan. Use for repayment volume and timing. For application-stage attributes use samples_bank.loan and samples_bank.underwriting.'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_bank_payment(
        I18N us_pst
        CONSTRAINTS (
             ADD payment_id NOS ZERO ()
             ADD loan_id NOS ZERO ()
             ADD payment_amount NOS ZERO ()
             ADD payment_date NOS ZERO ()
        )
        OUTPUTLIST (loan_id, payment_amount, payment_date, payment_id
        )
        WRAPPER (df ds_bank_payment)
    );

CREATE OR REPLACE TABLE property I18N us_pst (
        property_id:int,
        address:text,
        city:text,
        state:text,
        zip_code:text,
        property_value:double (description = 'Assessed value in USD')
    )
    FOLDER = '/02 - Datasets'
    DESCRIPTION = 'One row per collateral property. Join to samples_bank.loan on property_id for LTV-style analysis.'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_bank_property(
        I18N us_pst
        CONSTRAINTS (
             ADD property_id NOS ZERO ()
             ADD address NOS ZERO ()
             ADD city NOS ZERO ()
             ADD state NOS ZERO ()
             ADD zip_code NOS ZERO ()
             ADD property_value NOS ZERO ()
        )
        OUTPUTLIST (address, city, property_id, property_value, state, zip_code
        )
        WRAPPER (df ds_bank_property)
    );

CREATE OR REPLACE TABLE rate I18N us_pst (
        rate_id:int,
        loan_type:text (description = 'Mortgage rate program. Valid values (case-sensitive): Fixed, ARM_5_1 (5 years fixed then adjustable), ARM_7_1 (7 years fixed then adjustable), Jumbo_Fixed (non-conforming fixed-rate tier in this sample).'),
        term_years:int,
        interest_rate:double (description = 'Quoted annual rate as a percentage for this loan_type and term_years')
    )
    FOLDER = '/02 - Datasets'
    DESCRIPTION = 'Reference rows for offered rates by loan_type and term_years (years). Includes Fixed, ARM_5_1, ARM_7_1, and Jumbo_Fixed rows. Not transactional loan history.'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_bank_rate(
        I18N us_pst
        CONSTRAINTS (
             ADD rate_id NOS ZERO ()
             ADD loan_type NOS ZERO ()
             ADD term_years NOS ZERO ()
             ADD interest_rate NOS ZERO ()
        )
        OUTPUTLIST (interest_rate, loan_type, rate_id, term_years
        )
        WRAPPER (df ds_bank_rate)
    );

CREATE OR REPLACE TABLE underwriting I18N us_pst (
        underwriting_id:int,
        loan_id:int,
        credit_score:int (description = 'Underwriting credit score for the borrower at decision time'),
        employment_history:text (description = 'Valid values (case-sensitive): Stable, Varied'),
        financial_history:text (description = 'Valid values (case-sensitive): Good, Fair, Excellent, Bad')
    )
    FOLDER = '/02 - Datasets'
    DESCRIPTION = 'One row per loan credit assessment. Join to samples_bank.loan on loan_id.'
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD ds_bank_underwriting(
        I18N us_pst
        CONSTRAINTS (
             ADD underwriting_id NOS ZERO ()
             ADD loan_id NOS ZERO ()
             ADD credit_score NOS ZERO ()
             ADD employment_history NOS ZERO ()
             ADD financial_history NOS ZERO ()
        )
        OUTPUTLIST (credit_score, employment_history, financial_history, loan_id, underwriting_id
        )
        WRAPPER (df ds_bank_underwriting)
    );

CREATE OR REPLACE ASSOCIATION customer_accounts REFERENTIAL CONSTRAINT 
FOLDER = '/03 - Associations'
    DESCRIPTION = 'Maps customers to their accounts on customer_id. Use for balances and deposit activity alongside borrowing.'
    ENDPOINT account customer PRINCIPAL (0,1)
    ENDPOINT customers account (0,*)
    ADD MAPPING customer_id=customer_id;

CREATE OR REPLACE ASSOCIATION customer_loans REFERENTIAL CONSTRAINT 
FOLDER = '/03 - Associations'
    DESCRIPTION = 'Maps customers to loan applications on customer_id. Primary path for customer-level loan metrics.'
    ENDPOINT loan customer PRINCIPAL (0,1)
    ENDPOINT customers loan (0,*)
    ADD MAPPING customer_id=customer_id;

CREATE OR REPLACE ASSOCIATION loan_payments REFERENTIAL CONSTRAINT 
FOLDER = '/03 - Associations'
    DESCRIPTION = 'Maps loans to payment rows on loan_id. Use for repayment analysis, not for underwriting categories.'
    ENDPOINT payment loan PRINCIPAL (0,1)
    ENDPOINT loan payment (0,*)
    ADD MAPPING loan_id=loan_id;

CREATE OR REPLACE ASSOCIATION loan_underwritings REFERENTIAL CONSTRAINT 
FOLDER = '/03 - Associations'
    DESCRIPTION = 'Maps loans to underwriting attributes on loan_id. Use for credit and employment history with loan context.'
    ENDPOINT underwriting loan PRINCIPAL (0,1)
    ENDPOINT loan underwriting (0,*)
    ADD MAPPING loan_id=loan_id;

CREATE OR REPLACE ASSOCIATION loanofficer_loans REFERENTIAL CONSTRAINT 
FOLDER = '/03 - Associations'
    DESCRIPTION = 'Maps loan officers to loans they manage on loan_officer_id.'
    ENDPOINT loan loan_officer PRINCIPAL (0,1)
    ENDPOINT loan_officer loan (0,*)
    ADD MAPPING loan_officer_id=loan_officer_id;

CREATE OR REPLACE ASSOCIATION property_loans REFERENTIAL CONSTRAINT 
FOLDER = '/03 - Associations'
    DESCRIPTION = 'Maps collateral properties to loans on property_id.'
    ENDPOINT loan property PRINCIPAL (0,1)
    ENDPOINT property loan (0,*)
    ADD MAPPING property_id=property_id;

CLOSE;

EXIT SINGLE USER MODE;
