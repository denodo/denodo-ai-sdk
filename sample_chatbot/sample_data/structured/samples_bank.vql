    FOLDER = '/02 - Datasets'
    DATASOURCENAME=ds_bank_loan_officer
    OUTPUTSCHEMA (
        loan_officer_id = 'loan_officer_id',
        first_name = 'first_name',
        last_name = 'last_name',
        email = 'email',
        phone_number = 'phone_number'
